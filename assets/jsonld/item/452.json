operty_label":"Creator","is_public":true,"@value":"Fred D. Moore (lyricist)"},{"type":"literal","property_id":2,"property_label":"Creator","is_public":true,"@value":"Oscar Gardner (composer)"}],"dcterms:coverage":[{"type":"literal","property_id":14,"property_label":"Coverage","is_public":true,"@value":"Camden, New Jersey"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"The opening lyrics of this song, first recorded in 1915, showcase stereotypes around Chinese people\u2019s occupations and supposed opium addictions: \u201cChinaman, Chinaman, wash \u2018em laundry all day \/ Chinaman, Chinaman, smoke \u2018em pipe they say.\u201d The song uses woodblocks and parallel fourths but no twelve-bar blues forms; thus, it is a song that simply used \u201cblues\u201d as a marketing label."}],"dcterms:type":[{"type":"literal","property_id":8,"property_label":"Type","is_public":true,"@value":"ethnic humor"}]}