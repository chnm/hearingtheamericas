{"@context":"https:\/\/hearingtheamericas.org\/api-context","@id":"https:\/\/hearingtheamericas.org\/api\/items\/952","@type":["o:Item","bibo:Map"],"o:id":952,"o:is_public":true,"o:owner":{"@id":"https:\/\/hearingtheamericas.org\/api\/users\/4","o:id":4},"o:resource_class":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_classes\/70","o:id":70},"o:resource_template":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_templates\/5","o:id":5},"o:thumbnail":null,"o:title":"Tri-State Circuit","thumbnail_display_urls":{"large":null,"medium":null,"square":null},"o:created":{"@value":"2021-10-14T17:11:12+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:modified":{"@value":"2022-08-08T15:11:58+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:media":[],"o:item_set":[],"o:site":[{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/1","o:id":1},{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/2","o:id":2}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"Tri-State Circuit"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"Fred Barasso ran the Tri-State Circuit in the American South, providing opportunities for black performers across the American South. Circuits like this one provided mobility and economic opportunities for black performers throughout the nation. Some performers used the stage to achieve fame in the burgeoning recording industry, including blues queen Bessie Smith. These stages also provided platforms for black entertainers to make statements about the larger political context of Jim Crow America."}],"dcterms:temporal":[{"type":"literal","property_id":41,"property_label":"Temporal Coverage","is_public":true,"@value":"1910-1911"}],"dcterms:source":[{"type":"literal","property_id":11,"property_label":"Source","is_public":true,"@value":"Location data taken from descriptions in Lynn Abbott and