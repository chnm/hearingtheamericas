{"@context":"https:\/\/hearingtheamericas.org\/api-context","@id":"https:\/\/hearingtheamericas.org\/api\/items\/560","@type":["o:Item","foaf:Person"],"o:id":560,"o:is_public":true,"o:owner":{"@id":"https:\/\/hearingtheamericas.org\/api\/users\/9","o:id":9},"o:resource_class":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_classes\/94","o:id":94},"o:resource_template":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_templates\/3","o:id":3},"o:thumbnail":{"@id":"https:\/\/hearingtheamericas.org\/api\/assets\/47","o:id":47},"o:title":"Francisco Canaro","thumbnail_display_urls":{"large":"https:\/\/hearingtheamericas.org\/files\/asset\/b28ba8a7e286e37c8fbe370bb4aeddaee3100e5f.jpg","medium":"https:\/\/hearingtheamericas.org\/files\/asset\/b28ba8a7e286e37c8fbe370bb4aeddaee3100e5f.jpg","square":"https:\/\/hearingtheamericas.org\/files\/asset\/b28ba8a7e286e37c8fbe370bb4aeddaee3100e5f.jpg"},"o:created":{"@value":"2020-08-05T15:01:35+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:modified":{"@value":"2021-10-18T19:28:36+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:media":[{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/561","o:id":561}],"o:item_set":[{"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/55","o:id":55}],"o:site":[{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/1","o:id":1},{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/2","o:id":2}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"Francisco Canaro"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"A violinist, bandleader and composer, Francisco Canaro was a major figure in the early history of the tango. Although his career played out primarily in Argentina, Canaro, like many tango musicians, was born in Uruguay. Like many other Old Guard composers, but unlike the New Guard figures that came along in the 1920s, Canaro had little musical education, having been born into poverty. Nevertheless, he achieved remarkable longevity as a popular bandleader, becoming a proponent of the \"traditionalist\" style in contrast to that of \"evolutionists\" like Julio De Caro. Despite his traditionalism, Canaro was a pioneer: his was the first tango band to incorporate the bass (played by Afro-Argentine pioneer Leopoldo Thompson) and to include singers, who up to that point had only performed with guitar accompaniment. He toured Europe, recorded thousands of tangos, famously made a fortune, and became a key figure in the struggle to achieve legal copyright for composers in Argentina.  "}],"dcterms:type":[{"type":"customvocab:2","property_id":8,"property_label":"Type","is_public":true,"@value":"Band leader"},{"type":"customvocab:2","property_id":8,"property_label":"Type","is_public":true,"@value":"Musician"},{"type":"customvocab:2","property_id":8,"property_label":"Type","is_public":true,"@value":"Performer"}],"foaf:birthday":[{"type":"numeric:timestamp","property_id":182,"property_label":"birthday","is_public":true,"@value":"1888-11-26","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#date"}],"dcterms:dateSubmitted":[{"type":"numeric:timestamp","property_id":45,"property_label":"Date Submitted","is_public":true,"@value":"1964-12-14","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#date"}],"dcterms:subject":[{"type":"resource:itemset","property_id":3,"property_label":"Subject","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/67","value_resource_id":67,"value_resource_name":"item_sets","url":"\/s\/the-americas\/item-set\/67","display_title":"Tango","thumbnail_url":"https:\/\/hearingtheamericas.org\/files\/square\/4b3e46130c733ec75c9e87e2cbade6e7f031aafd.jpg","thumbnail_title":"Irresistible","thumbnail_type":"image\/jpeg"}]}