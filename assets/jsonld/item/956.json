{"@context":"https:\/\/hearingtheamericas.org\/api-context","@id":"https:\/\/hearingtheamericas.org\/api\/items\/956","@type":["o:Item","bibo:Map"],"o:id":956,"o:is_public":true,"o:owner":{"@id":"https:\/\/hearingtheamericas.org\/api\/users\/4","o:id":4},"o:resource_class":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_classes\/70","o:id":70},"o:resource_template":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_templates\/5","o:id":5},"o:thumbnail":null,"o:title":"Theater Owners' Booking Association","thumbnail_display_urls":{"large":null,"medium":null,"square":null},"o:created":{"@value":"2021-10-14T21:26:54+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:modified":{"@value":"2022-08-08T15:11:36+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:media":[],"o:item_set":[],"o:site":[{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/1","o:id":1},{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/2","o:id":2}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"Theater Owners' Booking Association"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"The Theater Owners' Booking Association, or T.O.B.A. as it became know, was a nationwide theater circuit for Black entertainers organized in 1921. It drew on the success of earlier regional circuits like the S.H. Dudley Circuit, but greatly expanded the potential reach of its artists. Many well-known Black performers appeared on T.O.B.A. stages, and their success and ticket sales helped to convince record companies to invest in the developing race records genre."}],"dcterms:temporal":[{"type":"literal","property_id":41,"property_label":"Temporal Coverage","is_public":true,"@value":"1920s"}],"dcterms:source":[{"type":"literal","property_id":11,"property_label":"Source","is_public":true,"@value":"Location data taken from descriptions in Lynn Abbott and Do