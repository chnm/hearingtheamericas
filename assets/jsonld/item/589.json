{"@context":"https:\/\/hearingtheamericas.org\/api-context","@id":"https:\/\/hearingtheamericas.org\/api\/items\/589","@type":["o:Item","foaf:Person"],"o:id":589,"o:is_public":true,"o:owner":{"@id":"https:\/\/hearingtheamericas.org\/api\/users\/5","o:id":5},"o:resource_class":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_classes\/94","o:id":94},"o:resource_template":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_templates\/3","o:id":3},"o:thumbnail":{"@id":"https:\/\/hearingtheamericas.org\/api\/assets\/39","o:id":39},"o:title":"Patrick \"Patsy\" Touhey","thumbnail_display_urls":{"large":"https:\/\/hearingtheamericas.org\/files\/asset\/2e3d580c5cdc447435a264aeef3780ae8146e609.jpg","medium":"https:\/\/hearingtheamericas.org\/files\/asset\/2e3d580c5cdc447435a264aeef3780ae8146e609.jpg","square":"https:\/\/hearingtheamericas.org\/files\/asset\/2e3d580c5cdc447435a264aeef3780ae8146e609.jpg"},"o:created":{"@value":"2020-12-01T16:49:43+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:modified":{"@value":"2021-10-18T19:09:54+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:media":[{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/934","o:id":934}],"o:item_set":[{"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/55","o:id":55}],"o:site":[{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/1","o:id":1},{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/2","o:id":2}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"Patrick \"Patsy\" Touhey"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"Patsy Touhey left Ireland at age three and as a very young man began performing on the Irish bagpipes. By the time he had entered his late teens he was a virtuoso on the instrument. Toughey was a professional performer his entire life, touring with \u201chibernicons\u201d which offered staged tour of Ireland, with George M. Cohan\u2019s family troupe, and in Vaudeville. He performed in the \u201cIrish Village\u201d at the 1893 Columbian Exposition and was among the first musicians to experiment with recording. His recording give us an example of  how ethnic music was played and received in the late 19th and early twentieth centuries.\n\nIn the 1890s Touhey began a mail order business in which customers would request tunes, and Touhey would play them onto an Edison Cylinder, then mail the cylinder to the customers at a rate of $10 per dozen. Later, when the \u201cethnic recording\u201d boom started after WWI Touhey recorded frequently: A 1919 recording has him playing a medley of reels starting with \u201cDrowsy Maggie.\u201d (https:\/\/www.loc.gov\/item\/jukebox-34198\/) Touhey\u2019s recordings helped establish the tradition, now common in Irish music, of playing three tunes in a row. \n\n     A \u201cstage Irishman,\u201d he often wore stereotypically Irish outfits and performed comic skits that mocked Irish accents and beliefs. At the 1904 St. Louis exposition a group of Irish and Irish American performers refused to go on stage with him, regarding his \u201cact\u201d as degrading.  \n"}],"dcterms:relation":[{"type":"literal","property_id":13,"property_label":"Relation","is_public":true,"@value":"\"Drowsy Maggie\"  "},{"type":"uri","property_id":13,"property_label":"Relation","is_public":true,"@id":"https:\/\/www.loc.gov\/item\/jukebox-34198\/"}],"dcterms:type":[{"type":"customvocab:2","property_id":8,"property_label":"Type","is_public":true,"@value":"Musician"},{"type":"customvocab:2","property_id":8,"property_label":"Type","is_public":true,"@value":"Performer"}],"foaf:birthday":[{"type":"numeric:timestamp","property_id":182,"property_label":"birthday","is_public":true,"@value":"1865-02-26","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#date"}],"dcterms:dateSubmitted":[{"type":"numeric:timestamp","property_id":45,"property_label":"Date Submitted","is_public":true,"@value":"1923-01-10","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#date"}],"dcterms:subject":[{"type":"resource:itemset","property_id":3,"property_label":"Subject","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/630","value_resource_id":630,"value_resource_name":"item_sets","url":"\/s\/the-americas\/item-set\/630","display_title":"Vaudeville","thumbnail_url":"https:\/\/hearingtheamericas.org\/files\/square\/18565120b9daf514b255ed10021bbbde9f9edaf6.jpg","thumbnail_title":"Keith's Palace Theater","thumbnail_type":"image\/jpeg"},{"type":"resource:itemset","property_id":3,"property_label":"Subject","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/944","value_resource_id":944,"value_resource_name":"item_sets","url":"\/s\/the-americas\/item-set\/944","display_title":"Ethnic Humor","thumbnail_url":"https:\/\/hearingtheamericas.org\/files\/square\/b85404fb04d449b78347511f3a16249ad4bc4b9c.jpg","thumbnail_title":"The_Germans_Arrival.png","thumbnail_type":"image\/png"}]}