{"@context":"https:\/\/hearingtheamericas.org\/api-context","@id":"https:\/\/hearingtheamericas.org\/api\/items\/387","@type":["o:Item","foaf:Person"],"o:id":387,"o:is_public":true,"o:owner":{"@id":"https:\/\/hearingtheamericas.org\/api\/users\/9","o:id":9},"o:resource_class":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_classes\/94","o:id":94},"o:resource_template":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_templates\/3","o:id":3},"o:thumbnail":{"@id":"https:\/\/hearingtheamericas.org\/api\/assets\/30","o:id":30},"o:title":"John Phillip Sousa","thumbnail_display_urls":{"large":"https:\/\/hearingtheamericas.org\/files\/asset\/2801820a4f7b0c436c120f398bc0e8aa12a48cad.jpg","medium":"https:\/\/hearingtheamericas.org\/files\/asset\/2801820a4f7b0c436c120f398bc0e8aa12a48cad.jpg","square":"https:\/\/hearingtheamericas.org\/files\/asset\/2801820a4f7b0c436c120f398bc0e8aa12a48cad.jpg"},"o:created":{"@value":"2020-06-11T18:35:41+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:modified":{"@value":"2022-06-05T17:07:38+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:media":[{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/388","o:id":388},{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/390","o:id":390},{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/391","o:id":391}],"o:item_set":[{"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/55","o:id":55}],"o:site":[{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/1","o:id":1},{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/2","o:id":2}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"John Phillip Sousa"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"John Phillip Sousa stands as one of the most significant composers in American music. Raised in Washington D.C.  by professional musicians from Portugal, Sousa found fame as the director of the U.S. Marine Corps Band. As a bandleader and composer, he specialized in brass band marches like \u201cStars and Stripes Forever,\" \"El Capitan,\" and \"Semper Fidelis.\u201d During Sousa\u2019s lifetime brass band were immensely popular in the U.S.  Groups like labor unions, colleges, and communities formed brass bands, often based on the members' experience in military marching bands. The popularity of brass bands, coupled with the expertise of the musicians, helps explain why brass bands were so nearly ubiquitous in the first two decades of recording. "}],"dcterms:type":[{"type":"customvocab:2","property_id":8,"property_label":"Type","is_public":true,"@value":"Band leader"},{"type":"customvocab:2","property_id":8,"property_label":"Type","is_public":true,"@value":"Musician"}],"foaf:birthday":[{"type":"numeric:timestamp","property_id":182,"property_label":"birthday","is_public":true,"@value":"1854-11-06","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#date"}],"dcterms:dateSubmitted":[{"type":"numeric:timestamp","property_id":45,"property_label":"Date Submitted","is_public":true,"@value":"1932-03-06","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#date"}],"dcterms:subject":[{"type":"literal","property_id":3,"property_label":"Subject","is_public":true,"@value":"Brass Band"}]}