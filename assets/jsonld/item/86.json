{"@context":"https:\/\/hearingtheamericas.org\/api-context","@id":"https:\/\/hearingtheamericas.org\/api\/items\/86","@type":["o:Item","dctype:Sound"],"o:id":86,"o:is_public":true,"o:owner":{"@id":"https:\/\/hearingtheamericas.org\/api\/users\/5","o:id":5},"o:resource_class":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_classes\/30","o:id":30},"o:resource_template":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_templates\/2","o:id":2},"o:thumbnail":null,"o:title":"When Old Bill Bailey Plays the Ukalele","thumbnail_display_urls":{"large":"https:\/\/hearingtheamericas.org\/files\/large\/c2da67d84a98caaf60f0386fa07a1ae219cf1594.jpg","medium":"https:\/\/hearingtheamericas.org\/files\/medium\/c2da67d84a98caaf60f0386fa07a1ae219cf1594.jpg","square":"https:\/\/hearingtheamericas.org\/files\/square\/c2da67d84a98caaf60f0386fa07a1ae219cf1594.jpg"},"o:created":{"@value":"2019-04-24T19:32:24+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:modified":{"@value":"2022-07-09T16:31:02+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:media":[{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/617","o:id":617},{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/87","o:id":87},{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/618","o:id":618}],"o:item_set":[{"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/56","o:id":56},{"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/68","o:id":68}],"o:site":[{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/1","o:id":1},{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/2","o:id":2}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"When Old Bill Bailey Plays the Ukalele"}],"dcterms:date":[{"type":"numeric:timestamp","property_id":7,"property_label":"Date","is_public":true,"@value":"1916","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#gYear"}],"dcterms:subject":[{"type":"resource","property_id":3,"property_label":"Subject","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/68","value_resource_id":68,"value_resource_name":"item_sets","url":"\/s\/the-americas\/item-set\/68","display_title":"Minstrelsy","thumbnail_url":"\/application\/asset\/thumbnails\/audio.png?v=3.1.2","thumbnail_title":"The Whistling Coon","thumbnail_type":"audio\/mpeg"}],"bibo:performer":[{"type":"resource","property_id":73,"property_label":"performer","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/items\/30","value_resource_id":30,"value_resource_name":"items","url":"\/s\/the-americas\/item\/30","display_title":"Nora Bayes","thumbnail_url":"https:\/\/hearingtheamericas.org\/files\/square\/a5df266b957b7db0d4f2b2294a019c73ddaef909.jpg","thumbnail_title":"NoraBayesApple1.jpg","thumbnail_type":"image\/jpeg"}],"dcterms:creator":[{"type":"literal","property_id":2,"property_label":"Creator","is_public":true,"@value":"Rosario Bourdon and Charles McCarron"}],"dcterms:publisher":[{"type":"literal","property_id":5,"property_label":"Publisher","is_public":true,"@value":"Victor"}],"dcterms:coverage":[{"type":"literal","property_id":14,"property_label":"Coverage","is_public":true,"@value":"Camden, New Jersey"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"In this song, recorded by the extremely  popular vaudeville singer Nora Bayes, Bill Bailey is older and has moved to Hawaii, where he takes up the Ukulele. Bayes aimed to cash on the fad for Hawaiian music which started around 1910, while also associating Bailey with \u201cragtime,\u201d another extremely popular fad of the era. The song combines lingering minstrel stereotypes with images of Hula girls and swaying palms: it mentions \u201csuffragettes\u201d who fail to convert \u201cthose gals of brown\u201d because of Bailey\u2019s music. Notice the instrumental opening, which includes the typical exaggerated pitch bends starting at 9 seconds, or when Bayes sings \u201cmiles around\u201d at about 27 seconds. Bayes herself was in \"Irishface,\" in the sense that she was born Rachel Goldberg and adopted the Irish sounding \"Nora Bayes\" as her stage name.\n"}],"dcterms:source":[{"type":"literal","property_id":11,"property_label":"Source","is_public":true,"@value":"Library of Congress  "}]}