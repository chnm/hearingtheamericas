{"@context":"https:\/\/hearingtheamericas.org\/api-context","@id":"https:\/\/hearingtheamericas.org\/api\/items\/1081","@type":["o:Item","foaf:Person"],"o:id":1081,"o:is_public":true,"o:owner":{"@id":"https:\/\/hearingtheamericas.org\/api\/users\/11","o:id":11},"o:resource_class":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_classes\/94","o:id":94},"o:resource_template":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_templates\/3","o:id":3},"o:thumbnail":{"@id":"https:\/\/hearingtheamericas.org\/api\/assets\/90","o:id":90},"o:title":"Gladys Bentley","thumbnail_display_urls":{"large":"https:\/\/hearingtheamericas.org\/files\/asset\/40bbf290f295bc390810b99b9cb21afde09597a8.jpg","medium":"https:\/\/hearingtheamericas.org\/files\/asset\/40bbf290f295bc390810b99b9cb21afde09597a8.jpg","square":"https:\/\/hearingtheamericas.org\/files\/asset\/40bbf290f295bc390810b99b9cb21afde09597a8.jpg"},"o:created":{"@value":"2022-06-05T17:15:58+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:modified":{"@value":"2022-06-06T15:04:28+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:media":[{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/1082","o:id":1082}],"o:item_set":[{"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/55","o:id":55}],"o:site":[{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/1","o:id":1},{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/2","o:id":2}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"Gladys Bentley"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"Born in Philadelphia in 1907, Gladys Bentley\u2019s greatest success came in the 1920s. Bentley built on the sexual and gender ambiguity pioneered by performers like Bessie Smith and Ma Rainey. In the 1920s. she was openly lesbian and frequently performed in male attire, a celebrated part of the New York City bohemian nightlife at Harry Hansberry's Clam House and the \u201cUbangi Club\u201d on Park Avenue. Bentley had a powerful voice and a knack for trumpet-like vocalizations. She knew how to produce \u201cthe blues\u201d on-demand for audiences who had come to expect a formula, but she gave the formula an exotic and ironic recitation. \n\nOn \u201cWild Geese Blues\u201d (1928), a duet with guitarist Eddie Lang, just as Bentley offered a twist on blues formulas, Lang cleverly inverted standard blues progressions.\n\nBentley\u2019s heyday coincided with prohibition: when she sang in \u201clegitimate,\u201d legal, establishments, she began to drop the nonconforming attire and perform in a more conventional style. Bentley\u2019s career shows us how \u201cthe blues\u201d emerged from novelty and urban sophistication as much as from rural life. "}],"foaf:birthday":[{"type":"numeric:timestamp","property_id":182,"property_label":"birthday","is_public":true,"@value":"1907-08-12","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#date"}],"dcterms:dateSubmitted":[{"type":"numeric:timestamp","property_id":45,"property_label":"Date Submitted","is_public":true,"@value":"1960-01-18","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#date"}],"dcterms:subject":[{"type":"resource:itemset","property_id":3,"property_label":"Subject","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/55","value_resource_id":55,"value_resource_name":"item_sets","url":"\/s\/the-americas\/item-set\/55","display_title":"Artists","thumbnail_url":"https:\/\/hearingtheamericas.org\/files\/square\/ddfc4293857e8580722178c993faf6a8e3ff1ee0.jpg","thumbnail_title":"The Phonogram Advertisement","thumbnail_type":"image\/jpeg"},{"type":"resource:itemset","property_id":3,"property_label":"Subject","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/632","value_resource_id":632,"value_resource_name":"item_sets","url":"\/s\/the-americas\/item-set\/632","display_title":"Blues","thumbnail_url":"\/application\/asset\/thumbnails\/audio.png?v=3.1.2","thumbnail_title":"The Memphis Blues","thumbnail_type":"audio\/mpeg"}]}