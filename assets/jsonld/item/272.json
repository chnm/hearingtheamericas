{"@context":"https:\/\/hearingtheamericas.org\/api-context","@id":"https:\/\/hearingtheamericas.org\/api\/items\/272","@type":["o:Item","dctype:Image"],"o:id":272,"o:is_public":true,"o:owner":{"@id":"https:\/\/hearingtheamericas.org\/api\/users\/9","o:id":9},"o:resource_class":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_classes\/26","o:id":26},"o:resource_template":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_templates\/4","o:id":4},"o:thumbnail":null,"o:title":"Advertisement for Mamie Smith's records","thumbnail_display_urls":{"large":"https:\/\/hearingtheamericas.org\/files\/large\/7272748d6c80b190afad5b0ee75bd06b0187f760.jpg","medium":"https:\/\/hearingtheamericas.org\/files\/medium\/7272748d6c80b190afad5b0ee75bd06b0187f760.jpg","square":"https:\/\/hearingtheamericas.org\/files\/square\/7272748d6c80b190afad5b0ee75bd06b0187f760.jpg"},"o:created":{"@value":"2020-06-09T14:01:40+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:modified":{"@value":"2020-09-23T15:39:59+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:media":[{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/273","o:id":273}],"o:item_set":[],"o:site":[{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/1","o:id":1},{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/2","o:id":2}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"Advertisement for Mamie Smith's records"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"Here, OKeh Records advertises Mamie Smith's new records, including her most famous song \"Crazy Blues.\" The song \"Mem'ries of You Mammy\" shows the minstrel show's influence on the early blues genre; mammy was a stereotype that developed during slavery and represented black women as only being fit to perform domestic and childcare duties. This caricature continued well into the Jim Crow era, and was ofte