{"@context":"https:\/\/hearingtheamericas.org\/api-context","@id":"https:\/\/hearingtheamericas.org\/api\/items\/416","@type":["o:Item","foaf:Person"],"o:id":416,"o:is_public":true,"o:owner":{"@id":"https:\/\/hearingtheamericas.org\/api\/users\/9","o:id":9},"o:resource_class":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_classes\/94","o:id":94},"o:resource_template":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_templates\/3","o:id":3},"o:thumbnail":{"@id":"https:\/\/hearingtheamericas.org\/api\/assets\/56","o:id":56},"o:title":"Julio De Caro","thumbnail_display_urls":{"large":"https:\/\/hearingtheamericas.org\/files\/asset\/14099657f2877989e5c38d18ae9f59add9101b13.png","medium":"https:\/\/hearingtheamericas.org\/files\/asset\/14099657f2877989e5c38d18ae9f59add9101b13.png","square":"https:\/\/hearingtheamericas.org\/files\/asset\/14099657f2877989e5c38d18ae9f59add9101b13.png"},"o:created":{"@value":"2020-06-26T16:57:16+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:modified":{"@value":"2022-03-13T14:55:54+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:media":[{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/417","o:id":417}],"o:item_set":[{"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/55","o:id":55}],"o:site":[{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/1","o:id":1},{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/2","o:id":2}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"Julio De Caro"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"Julio De Caro was a tango violinist, bandleader, and composer from Buenos Aires, Argentina. Beginning with the sextet he formed in 1924, he was probably the most influential of the New Guard composers who transformed the music of the tango in these years. The son of middle-class, Italian immigrants, De Caro received an extensive musical education as a child, and he used it to create a more sophisticated version of tango that featured complex harmonies and counterpoint. De Caro played a Stroh violin (a violin with the bell of a trumpet attached for amplification purposes) given to him by the technicians of the Victor Company. He continued to play the instrument even after electric recording technology made it unnecessary, because it conveyed an image of modernity. De Caro was a committed modernizer who sought to demonstrate that the tango was just as sophisticated as European concert music or jazz."}],"dcterms:type":[{"type":"customvocab:2","property_id":8,"property_label":"Type","is_public":true,"@value":"Musician"},{"type":"customvocab:2","property_id":8,"property_label":"Type","is_public":true,"@value":"Composer"}],"foaf:birthday":[{"type":"numeric:timestamp","property_id":182,"property_label":"birthday","is_public":true,"@value":"1899-12-11","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#date"}],"dcterms:dateSubmitted":[{"type":"numeric:timestamp","property_id":45,"property_label":"Date Submitted","is_public":true,"@value":"1980-03-11","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#date"}],"dcterms:subject":[{"type":"resource:itemset","property_id":3,"property_label":"Subject","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/67","value_resource_id":67,"value_resource_name":"item_sets","url":"\/s\/the-americas\/item-set\/67","display_title":"Tango","thumbnail_url":"https:\/\/hearingtheamericas.org\/files\/square\/4b3e46130c733ec75c9e87e2cbade6e7f031aafd.jpg","thumbnail_title":"Irresistible","thumbnail_type":"image\/jpeg"}]}