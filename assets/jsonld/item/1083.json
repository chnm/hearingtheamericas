{"@context":"https:\/\/hearingtheamericas.org\/api-context","@id":"https:\/\/hearingtheamericas.org\/api\/items\/1083","@type":["o:Item","foaf:Person"],"o:id":1083,"o:is_public":true,"o:owner":{"@id":"https:\/\/hearingtheamericas.org\/api\/users\/6","o:id":6},"o:resource_class":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_classes\/94","o:id":94},"o:resource_template":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_templates\/3","o:id":3},"o:thumbnail":{"@id":"https:\/\/hearingtheamericas.org\/api\/assets\/100","o:id":100},"o:title":"Donga","thumbnail_display_urls":{"large":"https:\/\/hearingtheamericas.org\/files\/asset\/e187d24c541cbc5f63c8978bf48f1de0a44dde62.jpg","medium":"https:\/\/hearingtheamericas.org\/files\/asset\/e187d24c541cbc5f63c8978bf48f1de0a44dde62.jpg","square":"https:\/\/hearingtheamericas.org\/files\/asset\/e187d24c541cbc5f63c8978bf48f1de0a44dde62.jpg"},"o:created":{"@value":"2022-06-08T15:31:13+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:modified":{"@value":"2022-07-26T06:53:16+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:media":[{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/1084","o:id":1084}],"o:item_set":[{"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/55","o:id":55},{"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/1093","o:id":1093}],"o:site":[{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/1","o:id":1},{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/2","o:id":2}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"Donga"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"Ernesto Joaquim Maria dos Santos, known as Donga, was an Afro-Brazilian musician and composer. Donga was credited as the composer of \"Pelo Telefone\" (1917), arguably the first recorded samba. In 1919, he joined Pixinguinha and six other musicians in founding