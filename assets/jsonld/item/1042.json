{"@context":"https:\/\/hearingtheamericas.org\/api-context","@id":"https:\/\/hearingtheamericas.org\/api\/items\/1042","@type":"o:Item","o:id":1042,"o:is_public":true,"o:owner":{"@id":"https:\/\/hearingtheamericas.org\/api\/users\/6","o:id":6},"o:resource_class":null,"o:resource_template":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_templates\/3","o:id":3},"o:thumbnail":null,"o:title":"Agust\u00edn Lara","thumbnail_display_urls":{"large":"https:\/\/hearingtheamericas.org\/files\/large\/f67bc51d2140f5a0f33f30a2baaa1bde720826f0.jpg","medium":"https:\/\/hearingtheamericas.org\/files\/medium\/f67bc51d2140f5a0f33f30a2baaa1bde720826f0.jpg","square":"https:\/\/hearingtheamericas.org\/files\/square\/f67bc51d2140f5a0f33f30a2baaa1bde720826f0.jpg"},"o:created":{"@value":"2021-12-23T19:19:56+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:modified":{"@value":"2022-03-14T16:24:07+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:media":[{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/1043","o:id":1043}],"o:item_set":[],"o:site":[{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/1","o:id":1},{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/2","o:id":2}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"Agust\u00edn Lara"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"Lara was a composer, pianist, and singer who popularized the bolero in Mexico. In the 1920s, Lara was working as a piano player in several Mexico City brothels. Inspired by Guty C\u00e1rdenas and other Yucatecan performers, he adopted the bolero. Although not a strong singer, Lara reinvented the genre by incorporating the piano and violin. Through his compositions as well as his work on radio and in film, Lara made the bolero the quintessential sound of urban, post-revolutionary Mexico."}],"dcterms:date":[{"type":"numeric:timestamp","p