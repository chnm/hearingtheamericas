{"@context":"https:\/\/hearingtheamericas.org\/api-context","@id":"https:\/\/hearingtheamericas.org\/api\/items\/33","@type":["o:Item","foaf:Person"],"o:id":33,"o:is_public":true,"o:owner":{"@id":"https:\/\/hearingtheamericas.org\/api\/users\/1","o:id":1},"o:resource_class":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_classes\/94","o:id":94},"o:resource_template":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_templates\/3","o:id":3},"o:thumbnail":{"@id":"https:\/\/hearingtheamericas.org\/api\/assets\/129","o:id":129},"o:title":"Lovie Austin","thumbnail_display_urls":{"large":"https:\/\/hearingtheamericas.org\/files\/asset\/cf3e88606874e85ace83c6a66302adbb6f42a9b6.jpg","medium":"https:\/\/hearingtheamericas.org\/files\/asset\/cf3e88606874e85ace83c6a66302adbb6f42a9b6.jpg","square":"https:\/\/hearingtheamericas.org\/files\/asset\/cf3e88606874e85ace83c6a66302adbb6f42a9b6.jpg"},"o:created":{"@value":"2017-11-28T13:13:09+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:modified":{"@value":"2025-05-06T16:46:06+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:media":[{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/1195","o:id":1195}],"o:item_set":[{"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/55","o:id":55}],"o:site":[{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/1","o:id":1},{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/2","o:id":2}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"Lovie Austin"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"Lovie Austin was a popular pianist, composer, arranger, and bandleader. Austin was a classically-trained pianist who studied music theory at Roger Williams University and Knoxville College. After her studies, Austin toured as a pianist on the Vaudeville circuit. Later, she settled in Chicago, where Austin was a sought after jazz accompanist, who played on albums with Ida Cox, Alberta Hunter, Ma Rainey, and Ethel Waters.  She also was adept at arranging and copywriting songs for publication.  She led her own jazz groups, including the Blues Serenaders.  Later, noted jazz pianist Mary Lou Williams remarked that Austin was her \u201cgreatest influence\u201d and that she was \"a fabulous woman and a fabulous musician too.\u201d  She said, \u201cI don't believe there's a woman around now who could compete with her. She was a greater talent than many of the men of this period.\" Lovie Austin shows us that women played pivotal roles in the history of early jazz. Furthermore, her life illustrates that while many believe that jazz stemmed from blues and folk traditions, her experience in earning a formal education and playing on Vaudeville stages influenced her jazz experience."}],"dcterms:type":[{"type":"customvocab:2","property_id":8,"property_label":"Type","is_public":true,"@value":"Composer"},{"type":"customvocab:2","property_id":8,"property_label":"Type","is_public":true,"@value":"Performer"}],"foaf:birthday":[{"type":"numeric:timestamp","property_id":182,"property_label":"birthday","is_public":true,"@value":"1887-09-19","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#date"}],"dcterms:dateSubmitted":[{"type":"numeric:timestamp","property_id":45,"property_label":"Date Submitted","is_public":true,"@value":"1972-07-08","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#date"}],"dcterms:subject":[{"type":"resource:itemset","property_id":3,"property_label":"Subject","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/55","value_resource_id":55,"value_resource_name":"item_sets","url":"\/s\/the-americas\/item-set\/55","display_title":"Artists","thumbnail_url":"https:\/\/hearingtheamericas.org\/files\/square\/ddfc4293857e8580722178c993faf6a8e3ff1ee0.jpg","thumbnail_title":"The Phonogram Advertisement","thumbnail_type":"image\/jpeg"},{"type":"resource:itemset","property_id":3,"property_label":"Subject","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/632","value_resource_id":632,"value_resource_name":"item_sets","url":"\/s\/the-americas\/item-set\/632","display_title":"Blues","thumbnail_url":"\/application\/asset\/thumbnails\/audio.png?v=3.1.2","thumbnail_title":"The Memphis Blues","thumbnail_type":"audio\/mpeg"},{"type":"resource:itemset","property_id":3,"property_label":"Subject","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/633","value_resource_id":633,"value_resource_name":"item_sets","url":"\/s\/the-americas\/item-set\/633","display_title":"Jazz","thumbnail_url":"\/application\/asset\/thumbnails\/audio.png?v=3.1.2","thumbnail_title":"La Patti Negra","thumbnail_type":"audio\/mpeg"}]}