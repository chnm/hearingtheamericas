{"@context":"https:\/\/hearingtheamericas.org\/api-context","@id":"https:\/\/hearingtheamericas.org\/api\/items\/541","@type":["o:Item","foaf:Person"],"o:id":541,"o:is_public":true,"o:owner":{"@id":"https:\/\/hearingtheamericas.org\/api\/users\/9","o:id":9},"o:resource_class":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_classes\/94","o:id":94},"o:resource_template":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_templates\/3","o:id":3},"o:thumbnail":{"@id":"https:\/\/hearingtheamericas.org\/api\/assets\/58","o:id":58},"o:title":"Rosita Quiroga","thumbnail_display_urls":{"large":"https:\/\/hearingtheamericas.org\/files\/asset\/19dea2962d122131af6fd1257d9d30ebd6ceb4f3.png","medium":"https:\/\/hearingtheamericas.org\/files\/asset\/19dea2962d122131af6fd1257d9d30ebd6ceb4f3.png","square":"https:\/\/hearingtheamericas.org\/files\/asset\/19dea2962d122131af6fd1257d9d30ebd6ceb4f3.png"},"o:created":{"@value":"2020-08-04T13:27:44+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:modified":{"@value":"2022-01-06T20:19:09+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:media":[{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/575","o:id":575}],"o:item_set":[{"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/55","o:id":55}],"o:site":[{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/1","o:id":1},{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/2","o:id":2}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"Rosita Quiroga "}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"Rosita Quiroga was the first of a large group of female tango singers who achieved fame in Argentina in the 1920s and 1930s. Of humble origins, Quiroga began her musical career as a singer of folk songs on the variety stage and on the radio.  In 1925, at the suggestion of the manager of the Buenos Aires branch of Victor Records, Quiroga recorded \"Nunca es tarde (It's never too late),\" a tango composed by Celedonio Flores. The song was a hit and launched Quiroga's career as a tango star. She would remain loyal to both Victor Records and to Flores through the 1920s. Her distinctive style was described as \"canyengue,\" or rootsy, and suggested a proud affiliation with the lower-class neighborhoods and slums that were considered the original birthplace of the tango."}],"dcterms:relation":[{"type":"literal","property_id":13,"property_label":"Relation","is_public":true,"@value":"tango"}],"foaf:birthday":[{"type":"numeric:timestamp","property_id":182,"property_label":"birthday","is_public":true,"@value":"1896-01-16","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#date"}],"dcterms:dateSubmitted":[{"type":"numeric:timestamp","property_id":45,"property_label":"Date Submitted","is_public":true,"@value":"1984-10-16","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#date"}],"dcterms:subject":[{"type":"resource:itemset","property_id":3,"property_label":"Subject","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/67","value_resource_id":67,"value_resource_name":"item_sets","url":"\/s\/the-americas\/item-set\/67","display_title":"Tango","thumbnail_url":"https:\/\/hearingtheamericas.org\/files\/square\/4b3e46130c733ec75c9e87e2cbade6e7f031aafd.jpg","thumbnail_title":"Irresistible","thumbnail_type":"image\/jpeg"}],"dcterms:hasPart":[{"type":"customvocab:2","property_id":34,"property_label":"Has Part","is_public":true,"@value":"Performer"},{"type":"customvocab:2","property_id":34,"property_label":"Has Part","is_public":true,"@value":"Lyricist"}]}