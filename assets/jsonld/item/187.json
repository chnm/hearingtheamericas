{"@context":"https:\/\/hearingtheamericas.org\/api-context","@id":"https:\/\/hearingtheamericas.org\/api\/items\/187","@type":["o:Item","foaf:Person"],"o:id":187,"o:is_public":true,"o:owner":{"@id":"https:\/\/hearingtheamericas.org\/api\/users\/5","o:id":5},"o:resource_class":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_classes\/94","o:id":94},"o:resource_template":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_templates\/3","o:id":3},"o:thumbnail":{"@id":"https:\/\/hearingtheamericas.org\/api\/assets\/25","o:id":25},"o:title":"Bert Williams","thumbnail_display_urls":{"large":"https:\/\/hearingtheamericas.org\/files\/asset\/487debc6986fdd58e7e1865ec68f09b617dc819a.jpg","medium":"https:\/\/hearingtheamericas.org\/files\/asset\/487debc6986fdd58e7e1865ec68f09b617dc819a.jpg","square":"https:\/\/hearingtheamericas.org\/files\/asset\/487debc6986fdd58e7e1865ec68f09b617dc819a.jpg"},"o:created":{"@value":"2019-05-23T18:08:09+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:modified":{"@value":"2022-06-05T16:46:31+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:media":[{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/961","o:id":961},{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/949","o:id":949}],"o:item_set":[{"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/55","o:id":55}],"o:site":[{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/1","o:id":1},{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/2","o:id":2}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"Bert Williams"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"Bert Williams was born in the Bahamas and came to the US in 1885, at age 11. As a teen, he performed in minstrel shows, eventually forming a partnership with George Walker. The duo became famous: when Walker retired from show business in 1907, Williams continued and became one of the most famous comedians of the era before WWI. He defended his use of blackface in multiple ways. He argued that blackface was mask that allowed him to adopt different, more creative personas.  Furthermore, he believed that since white people were making money dressing up as black people, black people themselves should  perform act in order to control the terms, and make the money. Walker was popular with both white and black audiences, in large part because he satirized popular minstrel and vaudeville stereotypes. His most famous song. \u201cNobody,\u201d offered a perfect example. The song exaggerates and mocks the musical and lyrical conventions of the minstrel show. "}],"dcterms:type":[{"type":"customvocab:2","property_id":8,"property_label":"Type","is_public":true,"@value":"Performer"}],"foaf:birthday":[{"type":"numeric:timestamp","property_id":182,"property_label":"birthday","is_public":true,"@value":"1874-11-12","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#date"}],"dcterms:dateSubmitted":[{"type":"numeric:timestamp","property_id":45,"property_label":"Date Submitted","is_public":true,"@value":"1922-03-04","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#date"}],"dcterms:subject":[{"type":"resource:itemset","property_id":3,"property_label":"Subject","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/68","value_resource_id":68,"value_resource_name":"item_sets","url":"\/s\/the-americas\/item-set\/68","display_title":"Minstrelsy","thumbnail_url":"\/application\/asset\/thumbnails\/audio.png?v=3.1.2","thumbnail_title":"The Whistling Coon","thumbnail_type":"audio\/mpeg"}]}