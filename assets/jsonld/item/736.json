{"@context":"https:\/\/hearingtheamericas.org\/api-context","@id":"https:\/\/hearingtheamericas.org\/api\/items\/736","@type":["o:Item","foaf:Person"],"o:id":736,"o:is_public":true,"o:owner":{"@id":"https:\/\/hearingtheamericas.org\/api\/users\/4","o:id":4},"o:resource_class":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_classes\/94","o:id":94},"o:resource_template":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_templates\/3","o:id":3},"o:thumbnail":{"@id":"https:\/\/hearingtheamericas.org\/api\/assets\/57","o:id":57},"o:title":"Jelly Roll Morton","thumbnail_display_urls":{"large":"https:\/\/hearingtheamericas.org\/files\/asset\/ac99f6532bbb772692caa2fd0f9638c6f861ca02.png","medium":"https:\/\/hearingtheamericas.org\/files\/asset\/ac99f6532bbb772692caa2fd0f9638c6f861ca02.png","square":"https:\/\/hearingtheamericas.org\/files\/asset\/ac99f6532bbb772692caa2fd0f9638c6f861ca02.png"},"o:created":{"@value":"2021-04-17T20:50:10+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:modified":{"@value":"2022-06-05T17:10:57+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:media":[{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/738","o:id":738},{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/737","o:id":737}],"o:item_set":[{"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/55","o:id":55}],"o:site":[{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/1","o:id":1},{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/2","o:id":2}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"Jelly Roll Morton"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"A \u201ccreole\u201d from New Orleans, of mixed French and African descent, pianist Ferdinande De Menthe played in salons and bordellos in the notorious \u201cStoryville\u201d district of New Orleans, where he took on the professional nickname \u201cJelly Roll Morton.\u201d Morton played in a style characteristic of New Orleans, with a very strongly pronounced influence from Cuba and the Caribbean. Morton is also credited as the first to make his own arrangements of jazz tunes. Morton was largely forgotten after WWI, until he was \u201crediscovered\u201d by folklorist Alan Lomax. Morton then made various hyperbolic claims to have \u201cinvented\u201d jazz, which he claimed was the mix of ragtime and \u201cthe Spanish tinge.\u201d His work helped to shape the evolution of jazz music and reflects early transnational influences in New Orleans' music scene. "}],"dcterms:type":[{"type":"customvocab:2","property_id":8,"property_label":"Type","is_public":true,"@value":"Musician"},{"type":"customvocab:2","property_id":8,"property_label":"Type","is_public":true,"@value":"Performer"},{"type":"customvocab:2","property_id":8,"property_label":"Type","is_public":true,"@value":"Composer"}],"foaf:birthday":[{"type":"numeric:timestamp","property_id":182,"property_label":"birthday","is_public":true,"@value":"1890-10-20","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#date"}],"dcterms:dateSubmitted":[{"type":"numeric:timestamp","property_id":45,"property_label":"Date Submitted","is_public":true,"@value":"1941-07-10","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#date"}],"dcterms:subject":[{"type":"resource:itemset","property_id":3,"property_label":"Subject","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/633","value_resource_id":633,"value_resource_name":"item_sets","url":"\/s\/the-americas\/item-set\/633","display_title":"Jazz","thumbnail_url":"\/application\/asset\/thumbnails\/audio.png?v=3.1.2","thumbnail_title":"La Patti Negra","thumbnail_type":"audio\/mpeg"}]}