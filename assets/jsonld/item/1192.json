{"@context":"https:\/\/hearingtheamericas.org\/api-context","@id":"https:\/\/hearingtheamericas.org\/api\/items\/1192","@type":["o:Item","foaf:Person"],"o:id":1192,"o:is_public":true,"o:owner":{"@id":"https:\/\/hearingtheamericas.org\/api\/users\/6","o:id":6},"o:resource_class":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_classes\/94","o:id":94},"o:resource_template":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_templates\/3","o:id":3},"o:thumbnail":null,"o:title":"Eduardo das Neves","thumbnail_display_urls":{"large":"https:\/\/hearingtheamericas.org\/files\/large\/246ee7b2b2217e5afa450e2b58c171a8d0b9697d.jpg","medium":"https:\/\/hearingtheamericas.org\/files\/medium\/246ee7b2b2217e5afa450e2b58c171a8d0b9697d.jpg","square":"https:\/\/hearingtheamericas.org\/files\/square\/246ee7b2b2217e5afa450e2b58c171a8d0b9697d.jpg"},"o:created":{"@value":"2023-03-25T13:50:49+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:modified":{"@value":"2023-03-25T13:54:10+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:media":[{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/1193","o:id":1193}],"o:item_set":[{"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/55","o:id":55},{"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/1093","o:id":1093}],"o:site":[{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/1","o:id":1},{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/2","o:id":2}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"Eduardo das Neves"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"Eduardo das Neves was one of the first professional recording artists in Brazil. Das Neves toured the country performing as a clown and a poet. An Afro-Brazilian, he cultivated the image of a malandro, or street hustler, a character type that would become central to Brazilian popular music for decades. His first recording was \"A Gargalhada,\" included in the first catalog of Casa Edison, the recording company founded in Rio de Janeiro by Jewish immigrant Fred Figner. Das Neves would remain one of Casa Edison's biggest stars for the next 16 years. Perhaps his most famous composition was \"Homenagem a Santos Dumont,\" an homage to the Brazilian aviation pioneer."}],"dcterms:type":[{"type":"customvocab:2","property_id":8,"property_label":"Type","is_public":true,"@value":"Musician"}],"foaf:birthday":[{"type":"numeric:timestamp","property_id":182,"property_label":"birthday","is_public":true,"@value":"1874","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#gYear"}],"dcterms:dateSubmitted":[{"type":"numeric:timestamp","property_id":45,"property_label":"Date Submitted","is_public":true,"@value":"1919","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#gYear"}],"dcterms:subject":[{"type":"resource:itemset","property_id":3,"property_label":"Subject","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/1093","value_resource_id":1093,"value_resource_name":"item_sets","url":"\/s\/the-americas\/item-set\/1093","display_title":"Brazilian Music","thumbnail_url":"https:\/\/hearingtheamericas.org\/files\/square\/8601717d69745f9764aebd541c1e9688a397148d.jpg","thumbnail_title":"OitoBatutas.jpeg","thumbnail_type":"image\/jpeg"}]}