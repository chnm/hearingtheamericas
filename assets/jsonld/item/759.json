{"@context":"https:\/\/hearingtheamericas.org\/api-context","@id":"https:\/\/hearingtheamericas.org\/api\/items\/759","@type":"o:Item","o:id":759,"o:is_public":true,"o:owner":{"@id":"https:\/\/hearingtheamericas.org\/api\/users\/4","o:id":4},"o:resource_class":null,"o:resource_template":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_templates\/7","o:id":7},"o:thumbnail":{"@id":"https:\/\/hearingtheamericas.org\/api\/assets\/53","o:id":53},"o:title":"Sexteto Habanero God\u00ednez","thumbnail_display_urls":{"large":"https:\/\/hearingtheamericas.org\/files\/asset\/a2b225ac450f39990d9b7bc1aa18af50407f17c2.jpg","medium":"https:\/\/hearingtheamericas.org\/files\/asset\/a2b225ac450f39990d9b7bc1aa18af50407f17c2.jpg","square":"https:\/\/hearingtheamericas.org\/files\/asset\/a2b225ac450f39990d9b7bc1aa18af50407f17c2.jpg"},"o:created":{"@value":"2021-04-21T18:03:21+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:modified":{"@value":"2022-03-14T14:35:00+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:media":[{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/760","o:id":760}],"o:item_set":[{"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/55","o:id":55}],"o:site":[{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/1","o:id":1},{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/2","o:id":2}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"Sexteto Habanero God\u00ednez"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"A Cuban son sextet organized in 1918 under the leadership of tres player, Carlos God\u00ednez, to record for Victor in Havana. Formed by working-class musicians from the barrio of Pueblo Nuevo on the outskirts of the city, the group's name was soon shortened to Sexteto Habanero.  The group's 1920 recordings, made in New York City, helped make it popular throughout Cuba. Known for making the son \"classy,\" by the 1930s they performed in exclusive Havana nightclubs. Although many original members left the group in the 1930s, the band continued performing under the name Sexteto Habanero for decades."}],"dcterms:hasPart":[{"type":"literal","property_id":34,"property_label":"Has Part","is_public":true,"@value":"Carlos God\u00ednez"},{"type":"literal","property_id":34,"property_label":"Has Part","is_public":true,"@value":"Guillermo Castillo"},{"type":"literal","property_id":34,"property_label":"Has Part","is_public":true,"@value":"Gerardo Mart\u00ednez"},{"type":"literal","property_id":34,"property_label":"Has Part","is_public":true,"@value":"Antonio Bacallao"},{"type":"literal","property_id":34,"property_label":"Has Part","is_public":true,"@value":"\u00d3scar Sotolongo"},{"type":"literal","property_id":34,"property_label":"Has Part","is_public":true,"@value":"Felipe Neri Cabrera"}],"dcterms:date":[{"type":"numeric:timestamp","property_id":7,"property_label":"Date","is_public":true,"@value":"1920","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#gYear"}],"dcterms:dateSubmitted":[{"type":"numeric:timestamp","property_id":45,"property_label":"Date Submitted","is_public":true,"@value":"2010","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#gYear"}],"dcterms:isPartOf":[{"type":"literal","property_id":33,"property_label":"Is Part Of","is_public":true,"@value":"Son"}]}