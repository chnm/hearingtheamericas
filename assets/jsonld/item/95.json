{"@context":"https:\/\/hearingtheamericas.org\/api-context","@id":"https:\/\/hearingtheamericas.org\/api\/items\/95","@type":["o:Item","dctype:Sound"],"o:id":95,"o:is_public":true,"o:owner":{"@id":"https:\/\/hearingtheamericas.org\/api\/users\/5","o:id":5},"o:resource_class":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_classes\/30","o:id":30},"o:resource_template":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_templates\/2","o:id":2},"o:thumbnail":null,"o:title":"I Don't Like that Face You Wear","thumbnail_display_urls":{"large":"https:\/\/hearingtheamericas.org\/files\/large\/7b6e8ee46f9f6c26995a8889276e506e74d246d6.jpg","medium":"https:\/\/hearingtheamericas.org\/files\/medium\/7b6e8ee46f9f6c26995a8889276e506e74d246d6.jpg","square":"https:\/\/hearingtheamericas.org\/files\/square\/7b6e8ee46f9f6c26995a8889276e506e74d246d6.jpg"},"o:created":{"@value":"2019-04-25T14:14:47+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:modified":{"@value":"2021-09-19T20:25:45+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:media":[{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/149","o:id":149},{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/96","o:id":96},{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/814","o:id":814}],"o:item_set":[{"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/56","o:id":56},{"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/68","o:id":68}],"o:site":[{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/1","o:id":1},{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/2","o:id":2}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"I Don't Like that Face You Wear"}],"dcterms:date":[{"type":"numeric:timestamp","property_id":7,"property_label":"Date","is_public":true,"@value":"1901","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#gYear"}],"dcterms:subject":[{"type":"resource","property_id":3,"property_label":"Subject","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/68","value_resource_id":68,"value_resource_name":"item_sets","url":"\/s\/the-americas\/item-set\/68","display_title":"Minstrelsy","thumbnail_url":"\/application\/asset\/thumbnails\/audio.png?v=3.1.2","thumbnail_title":"The Whistling Coon","thumbnail_type":"audio\/mpeg"}],"bibo:performer":[{"type":"literal","property_id":73,"property_label":"performer","is_public":true,"@value":"George Walker"},{"type":"resource","property_id":73,"property_label":"performer","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/items\/187","value_resource_id":187,"value_resource_name":"items","url":"\/s\/the-americas\/item\/187","display_title":"Bert Williams","thumbnail_url":"https:\/\/hearingtheamericas.org\/files\/square\/88d6a3bbe28a5c9ea91a66eb29eb2b39fe6c77d2.jpg","thumbnail_title":"BertWilliamsPhotoPortraitWithCigarette.jpg","thumbnail_type":"image\/jpeg"}],"dcterms:creator":[{"type":"resource","property_id":2,"property_label":"Creator","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/items\/185","value_resource_id":185,"value_resource_name":"items","url":"\/s\/the-americas\/item\/185","display_title":"Ernest Hogan","thumbnail_url":"https:\/\/hearingtheamericas.org\/files\/square\/8a5d254200cea4163cdfaba3defce72553bd1598.jpg","thumbnail_title":"Ernest Hogan","thumbnail_type":"image\/jpeg"}],"dcterms:publisher":[{"type":"literal","property_id":5,"property_label":"Publisher","is_public":true,"@value":"Victor"}],"dcterms:coverage":[{"type":"literal","property_id":14,"property_label":"Coverage","is_public":true,"@value":"Philadelphia, PA"}],"dcterms:mediator":[{"type":"literal","property_id":42,"property_label":"Mediator","is_public":true,"@value":"10 inch record"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"Ernest Hogan, the author of this song, is often credited as one of the originators of the ragtime style. He also, to his later regret, helped invent the \u201ccoon song.\u201d \u201cCoon\u201d was originally a slang term applied to white people. It described a person who was uneducated but slick, capable, tricky, and adaptable. Davy Crockett, the frontiersman, would describe himself as a \u201ccoon.\u201d Later the term gets applied to \u201cZip Coon,\u201d a stock character in the minstrel show who dressed in flashy clothes and flouted the law. In 1895 Hogan wrote a song called \u201cAll Coons Look Alike to Me,\u201d which introduced some elements of ragtime into vocal performance. It started a vogue for \u201ccoon songs,\u201d which carried the minstrel tradition into solo and duet performance. In this song, performed by Bert Williams and George Walker, the two men tell stories and sing and laugh in dialect. The lyrics describe a woman who dislikes  the face of her suitor. Williams and Walker initially billed themselves as \u201cThe Two Real Coons.\u201d Walker wrote: \u201cWe thought that as there seemed to be a great demand for black faces on the stage, we would do all we could to get what we felt belonged to us by the laws of nature.\u201d It\u2019s worth considering that \u201cI Don\u2019t Like that Face You Wear\u201d was sung by black men in blackface."}],"dcterms:type":[{"type":"literal","property_id":8,"property_label":"Type","is_public":true,"@value":"Minstrelsy"}],"dcterms:isReferencedBy":[{"type":"uri","property_id":35,"property_label":"Is Referenced By","is_public":true,"@id":"http:\/\/dev.omeka.org\/s\/the-americas\/page\/minstrelsy","o:label":"Minstrelsy"}]}