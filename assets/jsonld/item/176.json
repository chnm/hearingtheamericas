"bibo:performer":[{"type":"literal","property_id":73,"property_label":"performer","is_public":true,"@value":"Minstrels"}],"dcterms:creator":[{"type":"literal","property_id":2,"property_label":"Creator","is_public":true,"@value":"various"}],"dcterms:coverage":[{"type":"literal","property_id":14,"property_label":"Coverage","is_public":true,"@value":"Philadelphia, PA"}],"dcterms:mediator":[{"type":"literal","property_id":42,"property_label":"Mediator","is_public":true,"@value":"disk"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"This 1902 record, part 1 of a series, tries to capture the feeling of a minstrel show. It begins with an \"overture\" in which the band is accompanied by Mr. Bones clacking a pair of rib bones together in syncopated time with the music, then moves to a vocal performance of Stephen Foster's \"Old Folks at Home,\" a minstrel show standard, then back to the bones. A quartet version of \"Carry Me Back to Old Virginny,\" written by African American composer James Bland,  follows, and then a comic song. It ends with a version of Will Cook's \"Darktown is Out Tonight,\" from \"Clorindy\" of 1898, the first Broadway show with an all-black cast.  "}],"dcterms:type":[{"type":"literal","property_id":8,"property_label":"Type","is_public":true,"@value":"Minstrelsy"}]}