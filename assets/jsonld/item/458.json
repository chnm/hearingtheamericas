erty_id":2,"property_label":"Creator","is_public":true,"@value":"Harry Carrol (composer)"},{"type":"literal","property_id":2,"property_label":"Creator","is_public":true,"@value":"Ballard MacDonald (lyricist)"}],"dcterms:publisher":[{"type":"literal","property_id":5,"property_label":"Publisher","is_public":true,"@value":"Victor"}],"dcterms:coverage":[{"type":"literal","property_id":14,"property_label":"Coverage","is_public":true,"@value":"Camden, New Jersey"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"\u201cDown in Bom-Bombay\u201d was a Tin Pan Alley song recorded in 1915 that middle-class Americans would sing to amuse themselves. The song offers a glimpse of what people who knew nothing of Indian music thought Indian music might sound like. The sheet music cover reveals how people who had never been to India also had an exotic, sexualized view of the country and the people living there."}],"dcterms:hasVersion":[{"type":"literal","property_id":28,"property_label":"Has Version","is_public":true,"@value":"Collins and Harlan, Columbia (July 19, 1915) "}],"dcterms:type":[{"type":"literal","property_id":8,"property_label":"Type","is_public":true,"@value":"ethnic humor"}]}