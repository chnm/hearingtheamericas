{"@context":"https:\/\/hearingtheamericas.org\/api-context","@id":"https:\/\/hearingtheamericas.org\/api\/items\/1141","@type":["o:Item","foaf:Person"],"o:id":1141,"o:is_public":true,"o:owner":{"@id":"https:\/\/hearingtheamericas.org\/api\/users\/4","o:id":4},"o:resource_class":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_classes\/94","o:id":94},"o:resource_template":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_templates\/3","o:id":3},"o:thumbnail":null,"o:title":"S.H. Dudley","thumbnail_display_urls":{"large":"https:\/\/hearingtheamericas.org\/files\/large\/0f546a58ef82dc3ec0ad8c06b462bbae7d58ada8.jpg","medium":"https:\/\/hearingtheamericas.org\/files\/medium\/0f546a58ef82dc3ec0ad8c06b462bbae7d58ada8.jpg","square":"https:\/\/hearingtheamericas.org\/files\/square\/0f546a58ef82dc3ec0ad8c06b462bbae7d58ada8.jpg"},"o:created":{"@value":"2022-08-08T15:50:50+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:modified":{"@value":"2022-08-08T16:02:50+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:media":[{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/1142","o:id":1142}],"o:item_set":[{"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/55","o:id":55}],"o:site":[{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/1","o:id":1},{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/2","o:id":2}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"S.H. Dudley"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"Sherman Houston Dudley was a Black vaudeville performer, theater owner, and circuit manager. He was a successful performer and composer of ragtime music and coon songs, rising to fame as the lead in the well-known Smart Set. After years of performing, Dudley leveraged his fame and resources to get into the business side of the entertainment industry. He supported other Black artists through unions and developed his own theater circuit for Black performers. The popular S.H. Dudley circuit was very successful and supported by the Black press, and formed the foundation for the expansion of the national T.O.B.A. circuit in the 1920s."}],"dcterms:relation":[{"type":"resource","property_id":13,"property_label":"Relation","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/media\/1142","value_resource_id":1142,"value_resource_name":"media","url":"\/s\/the-americas\/media\/1142","display_title":"Sherman_Dudley.jpeg","thumbnail_url":"https:\/\/hearingtheamericas.org\/files\/square\/0f546a58ef82dc3ec0ad8c06b462bbae7d58ada8.jpg","thumbnail_title":"Sherman_Dudley.jpeg","thumbnail_type":"image\/jpeg"},{"type":"resource","property_id":13,"property_label":"Relation","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/items\/1095","value_resource_id":1095,"value_resource_name":"items","url":"\/s\/the-americas\/item\/1095","display_title":"Dudley Circuit Advertisement","thumbnail_url":"https:\/\/hearingtheamericas.org\/files\/square\/2607b7130caf1cba2eb528497c24df30d9445b9f.jpg","thumbnail_title":"Screen Shot 2022-06-27 at 8.25.11 PM.png","thumbnail_type":"image\/png"},{"type":"resource","property_id":13,"property_label":"Relation","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/items\/954","value_resource_id":954,"value_resource_name":"items","url":"\/s\/the-americas\/item\/954","display_title":"S.H. Dudley Circuit"}],"dcterms:type":[{"type":"customvocab:2","property_id":8,"property_label":"Type","is_public":true,"@value":"Performer"},{"type":"customvocab:2","property_id":8,"property_label":"Type","is_public":true,"@value":"Composer"},{"type":"customvocab:2","property_id":8,"property_label":"Type","is_public":true,"@value":"Promoter"}],"foaf:birthday":[{"type":"numeric:timestamp","property_id":182,"property_label":"birthday","is_public":true,"@value":"1872","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#gYear"}],"dcterms:dateSub