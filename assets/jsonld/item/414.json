{"@context":"https:\/\/hearingtheamericas.org\/api-context","@id":"https:\/\/hearingtheamericas.org\/api\/items\/414","@type":["o:Item","foaf:Person"],"o:id":414,"o:is_public":true,"o:owner":{"@id":"https:\/\/hearingtheamericas.org\/api\/users\/9","o:id":9},"o:resource_class":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_classes\/94","o:id":94},"o:resource_template":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_templates\/3","o:id":3},"o:thumbnail":{"@id":"https:\/\/hearingtheamericas.org\/api\/assets\/27","o:id":27},"o:title":"Celestino Ferrer","thumbnail_display_urls":{"large":"https:\/\/hearingtheamericas.org\/files\/asset\/5c17658e8680a249a4bd287a3e73b7c4ff7c049d.jpg","medium":"https:\/\/hearingtheamericas.org\/files\/asset\/5c17658e8680a249a4bd287a3e73b7c4ff7c049d.jpg","square":"https:\/\/hearingtheamericas.org\/files\/asset\/5c17658e8680a249a4bd287a3e73b7c4ff7c049d.jpg"},"o:created":{"@value":"2020-06-26T16:55:24+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:modified":{"@value":"2021-10-18T19:26:57+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:media":[{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/415","o:id":415}],"o:item_set":[{"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/55","o:id":55}],"o:site":[{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/1","o:id":1},{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/2","o:id":2}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"Celestino Ferrer"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"An early tango musician and bandleader from Buenos Aires, Ferrer achieved success in the tango boom that erupted in Paris in 1913. He performed in nightclubs and recorded for the Path\u00e9 label until the outbreak of World War I forced him to relocate to New York. There, Ferrer found himself once again in the right place at the right time. Needing a band to compete with Odeon's new hitmaker, Robert Firpo, Victor turned to Ferrer's group, the Orquesta T\u00edpica Argentina Celestino. The band recorded 125 sides between 1915 and 1919. He later returned to France, where his group made a living partly by performing dressed as gauchos in order to appeal to the local taste for the exotic. The transnational tango vogue provided Ferrer with career opportunities, but by leaving Argentina so early, he missed out on the stylistic transformations of the 1920s. As a result, Ferrer is now an obscure figure, having made very little lasting impact on the tango."}],"dcterms:type":[{"type":"customvocab:2","property_id":8,"property_label":"Type","is_public":true,"@value":"Musician"},{"type":"customvocab:2","property_id":8,"property_label":"Type","is_public":true,"@value":"Composer"}],"foaf:birthday":[{"type":"numeric:timestamp","property_id":182,"property_label":"birthday","is_public":true,"@value":"1885-06-27","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#date"}],"dcterms:dateSubmitted":[{"type":"numeric:timestamp","property_id":45,"property_label":"Date Submitted","is_public":true,"@value":"1958-03-04","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#date"}],"dcterms:subject":[{"type":"resource:itemset","property_id":3,"property_label":"Subject","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/67","value_resource_id":67,"value_resource_name":"item_sets","url":"\/s\/the-americas\/item-set\/67","display_title":"Tango","thumbnail_url":"https:\/\/hearingtheamericas.org\/files\/square\/4b3e46130c733ec75c9e87e2cbade6e7f031aafd.jpg","thumbnail_title":"Irresistible","thumbnail_type":"image\/jpeg"}]}