{"@context":"https:\/\/hearingtheamericas.org\/api-context","@id":"https:\/\/hearingtheamericas.org\/api\/items\/419","@type":"o:Item","o:id":419,"o:is_public":true,"o:owner":{"@id":"https:\/\/hearingtheamericas.org\/api\/users\/9","o:id":9},"o:resource_class":null,"o:resource_template":{"@id":"https:\/\/hearingtheamericas.org\/api\/resource_templates\/7","o:id":7},"o:thumbnail":{"@id":"https:\/\/hearingtheamericas.org\/api\/assets\/42","o:id":42},"o:title":"Orquesta T\u00edpica Fresedo","thumbnail_display_urls":{"large":"https:\/\/hearingtheamericas.org\/files\/asset\/21afb681e8f278c9b192bce3989ed672ae288476.jpg","medium":"https:\/\/hearingtheamericas.org\/files\/asset\/21afb681e8f278c9b192bce3989ed672ae288476.jpg","square":"https:\/\/hearingtheamericas.org\/files\/asset\/21afb681e8f278c9b192bce3989ed672ae288476.jpg"},"o:created":{"@value":"2020-06-26T16:58:28+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:modified":{"@value":"2022-03-13T14:35:19+00:00","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#dateTime"},"o:media":[{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/420","o:id":420},{"@id":"https:\/\/hearingtheamericas.org\/api\/media\/421","o:id":421}],"o:item_set":[{"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/55","o:id":55}],"o:site":[{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/1","o:id":1},{"@id":"https:\/\/hearingtheamericas.org\/api\/sites\/2","o:id":2}],"dcterms:title":[{"type":"literal","property_id":1,"property_label":"Title","is_public":true,"@value":"Orquesta T\u00edpica Fresedo"}],"dcterms:description":[{"type":"literal","property_id":4,"property_label":"Description","is_public":true,"@value":"Osvaldo Fresedo was a major figure in the tango's early years. A bandoneon player, composer, and bandleader, Fresedo first recorded for Victor Records in 1917. In 1921, the company brought him to the United States to record dozens of tangos as the leader of the Orquesta T\u00edpica Select. Back in Buenos Aires, Fresedo led various groups in the city's most aristocratic cabarets. The son of a well-to-do merchant, Fresedo was known for an elegant, upper-class style of tango. Seeking to create a modernized version of the Argentine genre, he experimented with incorporating the harp, vibraphone, and even the drums."}],"dcterms:hasPart":[{"type":"literal","property_id":34,"property_label":"Has Part","is_public":true,"@value":"Osvaldo Fresedo (bandleader, bandoneon)\nJulio De Caro (violin)\nJuan Koller (violin)\nJos\u00e9 Mar\u00eda Rizzuti (piano)\n Hugo Ricardo Baralis (double bass) "}],"dcterms:subject":[{"type":"resource","property_id":3,"property_label":"Subject","is_public":true,"@id":"https:\/\/hearingtheamericas.org\/api\/item_sets\/67","value_resource_id":67,"value_resource_name":"item_sets","url":"\/s\/the-americas\/item-set\/67","display_title":"Tango","thumbnail_url":"https:\/\/hearingtheamericas.org\/files\/square\/4b3e46130c733ec75c9e87e2cbade6e7f031aafd.jpg","thumbnail_title":"Irresistible","thumbnail_type":"image\/jpeg"}],"dcterms:date":[{"type":"numeric:timestamp","property_id":7,"property_label":"Date","is_public":true,"@value":"1918","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#gYear"}],"dcterms:dateSubmitted":[{"type":"numeric:timestamp","property_id":45,"property_label":"Date Submitted","is_public":true,"@value":"1979","@type":"http:\/\/www.w3.org\/2001\/XMLSchema#gYear"}]}